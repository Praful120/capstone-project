	"item": [
		{
			"name": "Security Tests",
			"item": [
				{
					"name": "SQL Injection Test",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"API handles SQL injection attempts safely\", function () {",
									"    pm.expect([200, 400, 422]).to.include(pm.response.code);",
									"});",
									"",
									"pm.test(\"No database error in response\", function () {",
									"    const responseText = pm.response.text();",
									"    pm.expect(responseText.toLowerCase()).to.not.include('sql');",
									"    pm.expect(responseText.toLowerCase()).to.not.include('database');",
									"    pm.expect(responseText.toLowerCase()).to.not.include('mysql');",
									"});",
									"",
									"pm.test(\"Response time is acceptable\", function () {",
									"    pm.expect(pm.response.responseTime).to.be.below(15000);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"'; DROP TABLE users; -- This is a SQL injection test to ensure the API handles malicious input safely.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/summarize",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"summarize"
							]
						},
						"description": "Test SQL injection prevention"
					},
					"response": []
				},
				{
					"name": "XSS Prevention Test",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"API handles XSS attempts safely\", function () {",
									"    pm.expect([200, 400, 422]).to.include(pm.response.code);",
									"});",
									"",
									"pm.test(\"Script tags are handled safely\", function () {",
									"    if (pm.response.code === 200) {",
									"        const jsonData = pm.response.json();",
									"        if (jsonData.summary) {",
									"            pm.expect(jsonData.summary).to.not.include('<script>');",
									"            pm.expect(jsonData.summary).to.not.include('alert(');",
									"        }",
									"    }",
									"});",
									"",
									"pm.test(\"Content-Type is application/json\", function () {",
									"    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"text\": \"<script>alert('XSS')</script>This is a test of XSS prevention in the summarization API. The system should handle script tags and other potentially dangerous HTML content safely.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/summarize",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"summarize"
							]
						},
						"description": "Test XSS prevention capabilities"
					},
					"response": []
				}
			],
			"description": "Security-focused test cases"
		},
		{
			"name": "Content Type Tests",
			"item": [
				{
					"name": "Wrong Content-Type Header",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"API rejects incorrect content type\", function () {",
									"    pm.expect([400, 415, 422]).to.include(pm.response.code);",
									"});",
									"",
									"pm.test(\"Error response structure is correct\", function () {",
									"    if (pm.response.code !== 200) {",
									"        const jsonData = pm.response.json();",
									"        pm.expect(jsonData).to.have.property('detail');",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/plain"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"text\": \"This should fail due to wrong content type header being set to text/plain instead of application/json\"}"
						},
