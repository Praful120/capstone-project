		{
			"name": "TTS Edge Cases",
			"item": [
				{
					"name": "TTS with Unsupported Language",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Unsupported language handled\", function () {",
									"    pm.expect([200, 400, 422]).to.include(pm.response.code);",
									"});",
									"",
									"if (pm.response.code === 400) {",
									"    pm.test(\"Error message for unsupported language\", function () {",
									"        const jsonData = pm.response.json();",
									"        pm.expect(jsonData.detail.toLowerCase()).to.include('language');",
									"    });",
									"}",
									"",
									"if (pm.response.code === 200) {",
									"    pm.test(\"Audio response for unsupported language\", function () {",
									"        pm.expect(pm.response.headers.get('Content-Type')).to.include('audio/mpeg');",
									"    });",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/tts?text=Test text with invalid language code&lang=xyz&slow=false",
